<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>VIRAT | Digital Ecosystem</title>
<style>
*{box-sizing:border-box}
:root{--bg:#03091a;--panel:#07152d;--line:#183c65;--text:#f3f6ff;--muted:#a9bce0;--blue:#5545ff}
body{margin:0;background:var(--bg);color:var(--text);font:15px Arial,sans-serif}
header{height:76px;display:flex;align-items:center;gap:16px;padding:12px 22px;border-bottom:1px solid var(--line);background:#06112a;position:sticky;top:0;z-index:2}
.brand{font-size:28px;font-weight:900;color:#a99aff;letter-spacing:2px}
.tag{color:#c8d5f8;border-left:1px solid #51618b;padding-left:18px}
.layout{display:flex;min-height:calc(100vh - 76px)}
aside{width:205px;flex-shrink:0;border-right:1px solid var(--line);padding:18px 12px;background:#040c1d}
aside a{display:block;color:#dce6ff;text-decoration:none;padding:13px 12px;border-radius:9px;margin-bottom:5px}
aside a:first-child{background:#4944e9}
main{padding:18px;min-width:0;flex:1}
.banner{min-height:155px;border:1px solid #24517b;border-radius:12px;padding:25px;text-align:center;background:linear-gradient(110deg,#092a36,#09142e 45%,#65401e 70%,#0c5937);overflow:hidden}
.banner h1{font-size:clamp(30px,5vw,54px);margin:0 0 6px}
.banner p{margin:0;font-size:17px}
.search{display:flex;gap:8px;margin:16px 0}
input{min-width:0;flex:1;background:#06132a;border:1px solid #24466d;border-radius:10px;padding:14px;color:white;font-size:15px}
button{background:#5545ff;color:white;border:0;border-radius:9px;padding:0 20px;font-weight:bold}
h2{font-size:20px;margin:20px 0 12px}
.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.card{background:linear-gradient(140deg,#081a35,#061126);border:1px solid var(--line);border-radius:11px;padding:13px;min-height:110px;color:var(--text);text-decoration:none;display:flex;align-items:center;gap:11px;min-width:0}
.card img{width:39px;height:39px;object-fit:contain;background:white;border-radius:9px;padding:4px;flex-shrink:0}
.card strong{display:block;overflow-wrap:anywhere;font-size:14px}
.card small{display:block;color:var(--muted);margin-top:7px}
.status{color:#22d9a2;font-size:12px;margin-top:8px}
footer{color:#8297bd;text-align:center;padding:25px}
@media(max-width:950px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}aside{width:165px}}
@media(max-width:620px){header{height:auto;padding:14px}.tag{font-size:12px}.layout{display:block}aside{width:100%;display:flex;overflow-x:auto;padding:8px;border-right:0;border-bottom:1px solid var(--line)}aside a{white-space:nowrap;margin:0 4px;padding:11px}main{padding:12px}.banner{min-height:130px;padding:22px 10px}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.card{padding:10px;min-height:95px;gap:8px}.card img{width:32px;height:32px}.card strong{font-size:12px}}
</style>
</head>
<body>
<header><div class="brand">◈ VIRAT</div><div class="tag">One Platform. Endless Possibilities.</div></header>
<div class="layout">
<aside>
<a href="#">⌂ Home</a><a href="#services">▦ All Services</a><a href="#services">✧ AI Tools</a><a href="#csc">▤ CSC Services</a><a href="#pay">▣ Payment</a><a href="#services">◆ Education</a><a href="#services">☁ Drive</a><a href="#services">▶ Videos</a><a href="#services">♧ Social Media</a><a href="#csc">▤ Government</a>
</aside>
<main>
<section class="banner"><h1>VIRAT 🇮🇳</h1><p>DIGITAL ECOSYSTEM</p><p>One Platform. Endless Possibilities.</p></section>
<div class="search"><input id="search" placeholder="Search VIRAT services..." aria-label="Search services"><button id="searchBtn">Search</button></div>
<h2>Featured Services</h2><div id="featured" class="grid"></div>
<h2 id="services">All 39 Services</h2><div id="all" class="grid"></div>
<h2 id="csc">Government & CSC Services</h2><div id="government" class="grid"></div>
<h2 id="pay">INSTANT PAY</h2><div class="card"><img alt="UPI logo" src="https://www.google.com/s2/favicons?domain=www.npci.org.in&sz=128"><div><strong>INSTANT PAY</strong><small>Payment demo only — no money transferred</small><div class="status">DEMO</div></div></div>
<footer>VIRAT DIGITAL ECOSYSTEM · Made for Digital India</footer>
</main>
</div>
<script>
const services=[
['V Search','google.com','Web Search'],['VIRAT AI','openai.com','AI Assistant'],['Government','india.gov.in','Government Services'],['Career','ncs.gov.in','Jobs & Career'],['Education','diksha.gov.in','Learning Platform'],['Drive','drive.google.com','Cloud Storage'],['Videos','youtube.com','Video Streaming'],['INSTANT PAY','npci.org.in','Payments'],['VIRAT CSC','csc.gov.in','Digital Services'],['Business','startupindia.gov.in','Business'],['Innovation','aim.gov.in','Innovation'],['Research','india.gov.in','Research'],['Technology','meity.gov.in','Technology'],['Agriculture','agriwelfare.gov.in','Agriculture'],['Health','mohfw.gov.in','Health'],['Local','india.gov.in','Local Services'],['Connect','whatsapp.com','Messaging'],['Trust','india.gov.in','Trust'],['Memory','google.com','Personal Workspace'],['Notifications','google.com','Notifications'],['Admin','github.com','Admin Console'],['Developer Cloud','github.com','Developer Tools'],['Opportunity Engine','ncs.gov.in','Opportunities'],['VIRAT Citizen Problem Hub','pgportal.gov.in','Public Grievances'],['V Maps','maps.google.com','Maps & Navigation'],['V Mail','gmail.com','Email'],['V Docs','docs.google.com','Documents'],['V Sheets','sheets.google.com','Spreadsheets'],['Slides','slides.google.com','Presentations'],['Calendar','calendar.google.com','Calendar'],['V Meet','meet.google.com','Video Meetings'],['Browser','google.com','Web Browser'],['Account','myaccount.google.com','Account'],['Photos','photos.google.com','Photos'],['V Translate','translate.google.com','Translation'],['Voice','microsoft.com','Voice Tools'],['V AI Studio','aistudio.google.com','AI Studio'],['News','news.google.com','News'],['Books & Research','books.google.com','Books & Research']];
const featuredNames=['V Search','VIRAT AI','VIRAT CSC','INSTANT PAY','Education','Drive'];
const govNames=['DigiLocker','UMANG','UIDAI Aadhaar','PAN Services','Passport Seva','National Career Service','MyScheme'];
const gov=[['DigiLocker','digilocker.gov.in'],['UMANG','web.umang.gov.in'],['UIDAI Aadhaar','uidai.gov.in'],['PAN Services','incometax.gov.in'],['Passport Seva','passportindia.gov.in'],['National Career Service','ncs.gov.in'],['MyScheme','myscheme.gov.in']];
function card(name,domain,desc){const a=document.createElement('a');a.className='card';a.href='https://'+domain;a.target='_blank';a.rel='noopener noreferrer';const img=document.createElement('img');img.loading='lazy';img.alt=name+' logo';img.src='https://www.google.com/s2/favicons?domain='+encodeURIComponent(domain)+'&sz=128';const d=document.createElement('div');const b=document.createElement('strong');b.textContent=name;const sm=document.createElement('small');sm.textContent=desc;const st=document.createElement('div');st.className='status';st.textContent='● Listed';d.append(b,sm,st);a.append(img,d);return a}
function draw(){const q=document.getElementById('search').value.toLowerCase().trim();const all=document.getElementById('all');all.replaceChildren();services.filter(x=>(x[0]+' '+x[2]).toLowerCase().includes(q)).forEach(x=>all.append(card(...x)));const f=document.getElementById('featured');f.replaceChildren();services.filter(x=>featuredNames.includes(x[0])&&(x[0]+' '+x[2]).toLowerCase().includes(q)).forEach(x=>f.append(card(...x)));const g=document.getElementById('government');g.replaceChildren();gov.filter(x=>x[0].toLowerCase().includes(q)).forEach(x=>g.append(card(x[0],x[1],'Official website')))}
document.getElementById('search').addEventListener('input',draw);document.getElementById('searchBtn').addEventListener('click',draw);draw();
</script>
</body>
</html>
